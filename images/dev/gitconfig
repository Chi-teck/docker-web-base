# vim:ft=gitconfig

[color]
  ui = auto
  grep = auto
[color "diff"]
  meta = magenta
[color "grep"]
  filename   = magenta
  linenumber = green
  match = red bold
[color "decorate"]
  remoteBranch = cyan
[core]
  excludesfile = ~/.gitignore
  pager=less -FXRS
[grep]
  lineNumber = true
[alias]
  l = log --graph --abbrev-commit --decorate --date=relative --format=format:\"%C(bold blue)%h%C(reset) - %C(yellow)%ar%C(reset) - %C(green)%an%C(reset) %C(white)%s%C(reset) %C(auto)%d%C(reset)\"
  d = !git --no-pager diff
[clean]
  requireForce = false
[pull]
  rebase = true
